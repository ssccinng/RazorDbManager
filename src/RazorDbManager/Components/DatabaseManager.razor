    private RenderFragment SqlPanel() => @<div class="rdm-sql-layout">
        <div class="rdm-editor">
            @if (selectedTable is not null)
            {
                <div class="rdm-sql-presets" role="toolbar" aria-label="@L["SqlTemplates"]">
                    <span class="rdm-context-meta">@L["SqlTemplates"]</span>
                    <button type="button" class="rdm-button" disabled="@busy" @onclick="() => SetSqlTemplate(SqlTemplateKind.Select)">SELECT</button>
                    <button type="button" class="rdm-button" disabled="@busy" @onclick="() => SetSqlTemplate(SqlTemplateKind.Where)">WHERE</button>
                    <button type="button" class="rdm-button" disabled="@busy" @onclick="() => SetSqlTemplate(SqlTemplateKind.Insert)">INSERT</button>
                    <button type="button" class="rdm-button" disabled="@busy" @onclick="() => SetSqlTemplate(SqlTemplateKind.Update)">UPDATE</button>
