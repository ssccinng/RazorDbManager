            }
            <div class="rdm-editor-head">
                <span class="rdm-editor-note">@L["SqlNotice"]</span>
                @if (sqlExecution is not null)
                {
                    <button class="rdm-button rdm-button-danger" title="@L["CancelSql"]" @onclick="CancelSql"><Icon Name="close" /> @L["CancelSql"]</button>
                }
                else
                {
                    <button class="rdm-button rdm-button-primary" disabled="@(ReadOnly || busy || string.IsNullOrWhiteSpace(sql))" @onclick="ExecuteSqlAsync"><Icon Name="execute" /> @L["Execute"]</button>
                }
            </div>
            <SqlEditor @bind-Value="sql" Placeholder="@L["SqlPlaceholder"]" AccessibilityLabel="@L["Sql"]" />
        </div>
        <div class="rdm-result-panel">
            @if (sqlResult is null)
            {
                <div class="rdm-empty"><div class="rdm-empty-inner"><div class="rdm-empty-icon"><Icon Name="result" Size="42" /></div><h3>@L["Result"]</h3></div></div>
            }
            else
            {
                <div class="rdm-result-head"><strong>@L["Result"]</strong><span class="rdm-context-meta">@L["Milliseconds", sqlResult.Elapsed.TotalMilliseconds.ToString("N0")]</span></div>
                @if (sqlResult.Truncated)
                {
                    <div class="rdm-alert" role="status"><Icon Name="alert" /><span>@L["SqlResultsTruncated"]</span></div>
                }
                @for (int resultIndex = 0; resultIndex < sqlResult.Results.Count; resultIndex++)
                {
                    SqlStatementResult result = sqlResult.Results[resultIndex];
                    if (result.Kind == SqlStatementResultKind.ResultSet)
                    {
                        int capturedResultIndex = resultIndex;
                        <div class="rdm-table-box">
                            <div class="rdm-result-set-head">
                                <span>@result.Rows.Count @L["Rows"]</span>
                                <button type="button" class="rdm-button" @onclick="() => DownloadSqlResultAsync(result, capturedResultIndex)"><Icon Name="download" /> @L["ExportResult"]</button>
                            </div>
                            <table class="rdm-grid">
                                <thead><tr>@foreach (DbColumnMetadata column in result.Columns) { <th>@column.Name</th> }</tr></thead>
                                <tbody>@foreach (IReadOnlyList<DbValue> row in result.Rows) { <tr>@foreach (DbValue value in row) { <td>@FormatValue(value)</td> }</tr> }</tbody>
                            </table>
                        </div>
                    }
                    else if (result.Kind == SqlStatementResultKind.Message)
                    {
                        <div class="rdm-alert rdm-sql-message">@(string.IsNullOrWhiteSpace(result.Message) ? L["NoMessage"] : result.Message)</div>
                    }
                    else
                    {
                        <div class="rdm-alert">@L["RowsAffected", result.AffectedRows ?? 0]</div>
                    }
                }
            }
        </div>
    </div>;

    private RenderFragment TransferPanel() => @<div class="rdm-transfer-grid">
        <div class="rdm-transfer-box">
            <h3>@L["ImportCsv"]</h3>
            <p>@L["ImportDescription"]</p>
            @if (!ReadOnly)
            {
            @if (selectedObject?.Kind != DbObjectKind.Table)
            {
                <div class="rdm-alert rdm-transfer-alert" role="status"><Icon Name="alert" /><span>@L["SelectTableForCsv"]</span></div>
            }
            <form method="post" enctype="multipart/form-data" action="/_razor-db-manager/imports" target="@uploadTarget">
                <AntiforgeryToken />
                <input type="hidden" name="@RazorDbComponentScopeProtector.FormFieldName" value="@componentScopeToken" />
                <input type="hidden" name="databaseId" value="@DatabaseId" />
                <input type="hidden" name="schema" value="@selectedObject?.Name.Schema" />
                <input type="hidden" name="table" value="@selectedObject?.Name.Name" />
                <input type="hidden" name="hasHeader" value="@importHasHeader.ToString().ToLowerInvariant()" />
                <input type="hidden" name="continueOnError" value="@importContinueOnError.ToString().ToLowerInvariant()" />
                <input type="hidden" name="decodeProtectedValues" value="@importDecodeProtectedValues.ToString().ToLowerInvariant()" />
                <div class="rdm-transfer-options">
                    <label class="rdm-check"><input type="checkbox" @bind="importHasHeader" /> @L["CsvHeader"]</label>
                    <label class="rdm-check"><input type="checkbox" @bind="importContinueOnError" /> @L["ContinueOnError"]</label>
                    <label class="rdm-check"><input type="checkbox" @bind="importDecodeProtectedValues" /> @L["RazorDbExport"]</label>
                    <label class="rdm-field"><span class="rdm-field-label">@L["Delimiter"]</span><select class="rdm-select" name="delimiter" @bind="importDelimiter"><option value=",">,</option><option value=";">;</option><option value="\t">@L["Tab"]</option><option value="|">|</option></select></label>
                    <label class="rdm-field"><span class="rdm-field-label">@L["NullToken"]</span><input class="rdm-input" name="nullToken" maxlength="64" @bind="importNullToken" /></label>
                </div>
                <input class="rdm-file" type="file" name="file" required accept=".csv,text/csv" disabled="@(selectedObject?.Kind != DbObjectKind.Table || !Has(RazorDbCapability.Import))" />
                <button type="submit" class="rdm-button rdm-button-primary" disabled="@(selectedObject?.Kind != DbObjectKind.Table || !Has(RazorDbCapability.Import))"><Icon Name="upload" /> @L["StartImport"]</button>
            </form>
            <div class="rdm-transfer-divider"></div>
            <h4>@L["SqlRestore"]</h4>
            @if (Has(RazorDbCapability.Import | RazorDbCapability.ExecuteSql))
            {
                <form method="post" enctype="multipart/form-data" action="/_razor-db-manager/imports" target="@uploadTarget">
                    <AntiforgeryToken />
                    <input type="hidden" name="@RazorDbComponentScopeProtector.FormFieldName" value="@componentScopeToken" />
                    <input type="hidden" name="databaseId" value="@DatabaseId" />
                    <input class="rdm-file" type="file" name="file" required accept=".sql,application/sql,text/plain" />
                    <button type="submit" class="rdm-button rdm-button-primary"><Icon Name="upload" /> @L["StartSqlRestore"]</button>
                </form>
            }
            else
            {
                <div class="rdm-context-meta">@L["SqlRestoreRequiresCapability"]</div>
            }
            <iframe class="rdm-upload-frame" title="@L["UploadResult"]" name="@uploadTarget"></iframe>
            }
        </div>
        <div class="rdm-transfer-box">
            <h3>@L["ExportCsv"]</h3>
            <p>@L["ExportDescription"]</p>
            <div class="rdm-transfer-options">
                <label class="rdm-check"><input type="checkbox" @bind="exportIncludeSchema" /> @L["IncludeSchema"]</label>
                <label class="rdm-check"><input type="checkbox" @bind="exportIncludeData" /> @L["IncludeData"]</label>
                <label class="rdm-check"><input type="checkbox" @bind="exportCompressWithGzip" /> @L["Gzip"]</label>
            </div>
            @if (selectedObject?.Kind != DbObjectKind.Table)
            {
                <div class="rdm-alert rdm-transfer-alert" role="status"><Icon Name="alert" /><span>@L["SelectTableForCsv"]</span></div>
            }
            <button class="rdm-button" disabled="@(ReadOnly || busy || !Has(RazorDbCapability.Export) || selectedObject?.Kind != DbObjectKind.Table || !exportIncludeData)" @onclick="() => ExportAsync(TransferFormat.Csv)"><Icon Name="download" /> CSV</button>
            <button class="rdm-button" disabled="@(ReadOnly || busy || !Has(RazorDbCapability.Export) || (!exportIncludeSchema && !exportIncludeData))" @onclick="() => ExportAsync(TransferFormat.Sql)"><Icon Name="download" /> SQL</button>
        </div>
    </div>;

    private RenderFragment ActivityPanel() => @<text>
        <div class="rdm-toolbar rdm-activity-toolbar">
            <span class="rdm-context-meta">@(HasActiveJobs ? L["ActivityAutoRefresh"] : L["ActivityUpdatedOnDemand"])</span>
            <button type="button" class="rdm-button" disabled="@activityLoading" @onclick="RefreshActivityAsync"><Icon Name="refresh" /> @L["Refresh"]</button>
        </div>
        <div class="rdm-activity-grid">
        <div class="rdm-activity-box rdm-session-query-box">
            <div class="rdm-list-head"><span>@L["SessionQueries"]</span><span class="rdm-session-label">@L["SessionOnly"]</span></div>
            @if (sessionQueryHistory.Entries.Count == 0) { <div class="rdm-empty"><div class="rdm-empty-inner">@L["NoSessionQueries"]</div></div> }
            @foreach (SessionQueryLogEntry entry in sessionQueryHistory.Entries)
            {
                <div class="rdm-session-query-row">
                    <div class="rdm-session-query-head">
                        <div><div class="rdm-activity-name"><code>@entry.Table.Schema.@entry.Table.Name</code></div><div class="rdm-activity-meta">@L["RowsReturned"]: @entry.RowsReturned.ToString("N0") · @L["CommandCount", entry.Commands.Count]@if (entry.Truncated) { <span> · @L["Truncated"]</span> }</div></div>
                        <time>@entry.Timestamp.LocalDateTime.ToString("g")</time>
                    </div>
                    <details class="rdm-session-sql">
                        <summary>@L["ViewSql"]</summary>
                        <div class="rdm-query-command-list">
                            @for (int commandIndex = 0; commandIndex < entry.Commands.Count; commandIndex++)
                            {
                                DbCommandDiagnostic command = entry.Commands[commandIndex];
                                <section class="rdm-query-command">
                                    <div class="rdm-result-head"><strong>@L["CommandNumber", commandIndex + 1]</strong><span class="rdm-context-meta">@L["Milliseconds", command.Elapsed.TotalMilliseconds.ToString("N0")]</span></div>
                                    <pre class="rdm-command-sql"><code>@command.CommandText</code></pre>
                                    @if (command.Parameters.Count > 0)
                                    {
                                        <div class="rdm-command-parameters">
                                            @foreach (DbCommandParameterDiagnostic parameter in command.Parameters)
                                            {
                                                <div class="rdm-command-parameter"><code>@parameter.Name</code><span>@parameter.DatabaseType</span><code>@parameter.ValuePreview</code></div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rdm-context-meta rdm-command-empty">@L["NoParameters"]</div>
                                    }
                                </section>
                            }
                        </div>
                    </details>
                </div>
            }
        </div>
        <div class="rdm-activity-box">
            <div class="rdm-list-head">@L["RecentJobs"]</div>
            @if (jobs.Count == 0) { <div class="rdm-empty"><div class="rdm-empty-inner">@L["NoActivity"]</div></div> }
            @foreach (RazorDbJobRecord job in jobs)
            {
                <div class="rdm-activity-row"><div><div class="rdm-activity-name">@L[job.Kind.ToString()]</div><div class="rdm-activity-meta">@job.Id</div><div class="rdm-activity-meta">@job.RowsProcessed.ToString("N0") @L["Rows"] · @FormatBytes(job.BytesProcessed)</div>@if (!string.IsNullOrWhiteSpace(job.ResultCode)) { <div class="rdm-activity-meta">@L["ResultCode"]: @job.ResultCode</div> }</div><span>@L[job.Status.ToString()]</span><div class="rdm-activity-actions"><time>@job.UpdatedAt.LocalDateTime.ToString("g")</time>@if (!ReadOnly && job.Status is RazorDbJobStatus.Queued or RazorDbJobStatus.Running) { <button type="button" class="rdm-button rdm-icon-button rdm-button-danger" disabled="@busy" title="@L["CancelJob"]" @onclick="() => CancelJobAsync(job)"><Icon Name="close" /></button> }@if (!ReadOnly && job.Status == RazorDbJobStatus.Completed && job.OutputArtifactId is not null) { <form class="rdm-inline-form" method="post" action="@($"/_razor-db-manager/artifacts/{Uri.EscapeDataString(job.OutputArtifactId)}/token")" target="_blank"><AntiforgeryToken /><input type="hidden" name="@RazorDbComponentScopeProtector.FormFieldName" value="@componentScopeToken" /><button type="submit" class="rdm-button rdm-icon-button" title="@L["Download"]"><Icon Name="download" /></button></form> }</div></div>
            }
        </div>
        <div class="rdm-activity-box">
            <div class="rdm-list-head">@L["AuditLog"]</div>
            @if (audit.Count == 0) { <div class="rdm-empty"><div class="rdm-empty-inner">@L["NoActivity"]</div></div> }
            @foreach (RazorDbAuditRecord item in audit)
            {
                <div class="rdm-activity-row"><div><div class="rdm-activity-name">@L[item.Operation.ToString()]</div><div class="rdm-activity-meta">@item.Resource?.Object</div>@if (!string.IsNullOrWhiteSpace(item.ResultCode)) { <div class="rdm-activity-meta">@L["ResultCode"]: @item.ResultCode</div> }</div><span>@L[item.Status.ToString()]</span><time>@item.Timestamp.LocalDateTime.ToString("g")</time></div>
            }
        </div>
        </div>
    </text>;

    private static string CompactNumber(long value) => value switch { >= 1_000_000 => $"{value / 1_000_000d:0.#}m", >= 1_000 => $"{value / 1_000d:0.#}k", _ => value.ToString(CultureInfo.InvariantCulture) };
    private string? CreateTableSchema
    {
        get
        {
            if (database is null || database.Schemas.Count == 0) return null;
            if (!string.IsNullOrWhiteSpace(database.DefaultSchema)
                && database.Schemas.Any(schema => string.Equals(schema.Name, database.DefaultSchema, StringComparison.OrdinalIgnoreCase)))
                return database.DefaultSchema;
            return database.Schemas.Count == 1 ? database.Schemas[0].Name : null;
        }
    }

    private static DbTableMetadata EmptyTable(string schema) => new(
        new DbObjectName(schema, "__new_table__"),
        DbObjectKind.Table,
        [], [], [], [], null, string.Empty);

    private string TabId(WorkspaceTab tab) => $"{componentId}-tab-{tab.ToString().ToLowerInvariant()}";
    private string PanelId(WorkspaceTab tab) => $"{componentId}-panel-{tab.ToString().ToLowerInvariant()}";

    private void OpenMobileTree() { mobileTreeOpen = true; pendingModal = ModalKind.MobileTree; }
    private async Task CloseMobileTreeAsync() { await ReleaseModalAsync(); mobileTreeOpen = false; }

    private async Task ReleaseModalAsync()
    {
        if (modalSession is null) return;
        IJSObjectReference session = modalSession;
        modalSession = null;
        try { await session.InvokeVoidAsync("deactivate"); }
        catch (JSDisconnectedException) { }
        finally
        {
            try { await session.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
    private static string FormatBytes(long value) => value switch { >= 1024L * 1024 * 1024 => $"{value / (1024d * 1024 * 1024):0.#} GiB", >= 1024L * 1024 => $"{value / (1024d * 1024):0.#} MiB", >= 1024L => $"{value / 1024d:0.#} KiB", _ => $"{value} B" };
    private string SortIndicator(string column) => string.Equals(sortColumn, column, StringComparison.Ordinal) ? sortDirection switch
    {
        DbSortDirection.Ascending => "↑",
        DbSortDirection.Descending => "↓",
        _ => string.Empty,
    } : string.Empty;
    private string SortTitle(string column) => string.Equals(sortColumn, column, StringComparison.Ordinal) ? sortDirection switch
    {
        DbSortDirection.Ascending => L["SortDescending"],
        DbSortDirection.Descending => L["ClearSort"],
        _ => L["SortAscending"],
    } : L["SortAscending"];
    private string FormatValue(DbValue value) => value.Kind switch { DbValueKind.Null => "NULL", DbValueKind.Binary or DbValueKind.Geometry => L["BinaryValue", L[value.Kind.ToString()], value.Binary.Length], _ => value.Text ?? string.Empty };
    private string DisplayObjectKind(DbObjectKind kind) => L[kind.ToString()];
    private string DisplayBoolean(bool value) => L[value ? "Yes" : "No"];
    private string DisplayError(Exception exception) => L[exception switch
    {
        RazorDbException { Code: RazorDbErrorCode.Validation } => "InvalidRequest",
        RazorDbException { Code: RazorDbErrorCode.Forbidden } => "Unauthorized",
        RazorDbException { Code: RazorDbErrorCode.NotFound } => "ResourceNotFound",
        RazorDbException { Code: RazorDbErrorCode.Conflict } => "OperationConflict",
        RazorDbException { Code: RazorDbErrorCode.LimitExceeded } => "LimitExceeded",
        RazorDbException { Code: RazorDbErrorCode.Unsupported } => "UnsupportedOperation",
        RazorDbException { Code: RazorDbErrorCode.DatabaseAuthentication } => "DatabaseAuthenticationFailed",
        RazorDbException { Code: RazorDbErrorCode.DatabaseUnavailable } => "Unavailable",
        RazorDbException { Code: RazorDbErrorCode.DatabaseRejected } => "DatabaseRejected",
        RazorDbException { Code: RazorDbErrorCode.Cancelled } or OperationCanceledException => "OperationCancelled",
        _ => "OperationFailed",
    }];
    private bool CanDownloadBinary(DbRow row, DbColumnMetadata column, DbValue value) =>
        selectedTable is not null
        && Has(RazorDbCapability.DownloadBinary)
        && row.EffectiveBinaryIdentity is not null
        && !value.IsNull
        && column.Type.Kind is DbDataKind.Binary or DbDataKind.Geometry;
    private string BinaryDownloadPayload(DbRow row, DbColumnMetadata column)
    {
        RowIdentity identity = row.EffectiveBinaryIdentity!;
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            databaseId = DatabaseId,
            schema = selectedTable!.Name.Schema,
            table = selectedTable.Name.Name,
            column = column.Name,
            keyName = identity.KeyName,
            identity = identity.Values.Select(pair => new
            {
                column = pair.Key,
                kind = pair.Value.Kind,
                text = pair.Value.Kind is DbValueKind.Binary or DbValueKind.Geometry ? null : pair.Value.Text,
                base64 = pair.Value.Kind is DbValueKind.Binary or DbValueKind.Geometry
                    ? Convert.ToBase64String(pair.Value.Binary.Span)
                    : null,
            }).ToArray(),
        });
    }
    private void ClearSelection() { selectedObject = null; selectedTable = null; rowPage = null; pageNavigation.Reset(); selectedRows.Clear(); CloseEditor(); deletingRow = null; deletingRows.Clear(); deleteError = null; }

    private async Task ResetDatabaseStateAsync()
    {
        await ReleaseModalAsync();
        StopActivityPolling();
        sqlExecution?.Cancel();
        sqlExecution = null;
        database = null;
        registrationName = null;
        selectedObject = null;
        selectedTable = null;
        schemaEditorTable = null;
        rowPage = null;
        sqlResult = null;
        jobs = [];
        audit = [];
        sessionQueryHistory.Clear();
        activeTab = WorkspaceTab.Data;
        editingRow = null;
        deletingRow = null;
        deletingRows.Clear();
        selectedRows.Clear();
        editorOpen = false;
        schemaEditorOpen = false;
        mobileTreeOpen = false;
        error = null;
        editorError = null;
        deleteError = null;
        schemaError = null;
        objectSearch = string.Empty;
        sql = string.Empty;
        pendingSchemaChange = null;
        ddlPreview = null;
        pendingModal = null;
        ResetQueryControls();
    }
    public async ValueTask DisposeAsync()
    {
        StopComponentScopeRefresh();
        StopActivityPolling();
        sqlExecution?.Cancel();
        lifetime.Cancel();
        lifetime.Dispose();
        await ReleaseModalAsync();
        if (browserModule is not null)
        {
            try { await browserModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (accessibilityModule is not null)
        {
            try { await accessibilityModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
    private enum ModalKind { MobileTree, RowEditor, SchemaEditor, Delete }
}
