<div class="rdm-empty">
    <div class="rdm-empty-inner">
        <div class="rdm-empty-icon"><Icon Name="@IconName" Size="42" /></div>
        <h3>@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string IconName { get; set; } = "database";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
