<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RazorDbManager.MySql</PackageId>
    <Description>MySQL and MariaDB provider for RazorDbManager.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="\" />
    <None Include="..\..\SECURITY.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="MySqlConnector" />
    <ProjectReference Include="..\RazorDbManager.Core\RazorDbManager.Core.csproj" />
    <ProjectReference Include="..\RazorDbManager\RazorDbManager.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RazorDbManager.MySql.Tests" />
  </ItemGroup>
</Project>
